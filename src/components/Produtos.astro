---
// Cada card leva direto ao WhatsApp com a mensagem do escopo preenchida.
import { linkWhatsapp } from '../dados/contato';
import type { Textos } from '../dados/textos';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const link = (escopo: string) => linkWhatsapp(t.wa.escopo(escopo));
---

<section id="servicos" class="orbitas">
  <header class="orbitas-head">
    <p class="mono">{t.produtos.eyebrow}</p>
    <h2>{t.produtos.titulo}</h2>
    <p class="orbitas-lead">{t.produtos.lead}</p>
  </header>

  <div class="tiers">
    {
      t.produtos.itens.map((p) => (
        <article class="tier">
          <p class="mono">{p.eyebrow}</p>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
          <a class="tier-cta" href={link(p.escopo)} target="_blank" rel="noopener">
            {t.produtos.cta}
          </a>
        </article>
      ))
    }

    <article class="tier tier-plus">
      <div class="tier-plus-copy">
        <p class="mono">{t.produtos.plus.eyebrow}</p>
        <h3>{t.produtos.plus.titulo}</h3>
        <p>{t.produtos.plus.texto}</p>
      </div>
      <a class="tier-cta" href={link(t.produtos.plus.escopo)} target="_blank" rel="noopener">
        {t.produtos.cta}
      </a>
    </article>
  </div>
</section>
