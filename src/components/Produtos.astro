---
// Seis frentes numa grade de três colunas, então as duas fileiras fecham sem
// buraco. Cada card leva direto ao WhatsApp com a mensagem do escopo pronta.
import { linkWhatsapp } from '../dados/contato';
import type { Textos } from '../dados/textos';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const link = (escopo: string) => linkWhatsapp(t.wa.escopo(escopo));
// A frente de IA é a mais nova da lista e ganha a borda de destaque.
const destaque = new Set(['operações com IA', 'AI operations']);
---

<section id="servicos" class="orbitas">
  <header class="orbitas-head">
    <p class="mono">{t.produtos.eyebrow}</p>
    <h2>{t.produtos.titulo}</h2>
    <p class="orbitas-lead">{t.produtos.lead}</p>
  </header>

  <div class="tiers">
    {
      t.produtos.itens.map((p) => (
        <article class:list={['tier', { 'tier-destaque': destaque.has(p.escopo) }]}>
          <p class="mono">{p.eyebrow}</p>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
          <a class="tier-cta" href={link(p.escopo)} target="_blank" rel="noopener">
            {t.produtos.cta}
          </a>
        </article>
      ))
    }
  </div>
</section>
