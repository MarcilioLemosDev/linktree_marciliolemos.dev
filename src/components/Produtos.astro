---
// Produtos. Todos os CTAs abrem o MESMO formulário ([data-form]) já com o
// escopo escolhido (data-escopo), então a captura sai num formato único.
const produtos = [
  {
    eyebrow: '01 · Web',
    titulo: 'Sites e landing pages',
    texto:
      'Institucional, landing de conversão ou vitrine de produtos. Carrega rápido, aparece na busca e converte no celular, onde está a maior parte do tráfego.',
    escopo: 'Um site',
  },
  {
    eyebrow: '02 · Apps',
    titulo: 'Aplicativos',
    texto:
      'Web, mobile e desktop. Do MVP que valida a ideia ao aplicativo publicado, com login, integrações e painel de administração.',
    escopo: 'Um aplicativo',
  },
  {
    eyebrow: '03 · Dados',
    titulo: 'Dados e BI',
    texto:
      'Dashboards, integração de fontes e relatórios automáticos. Os números saem da planilha manual e chegam prontos, atualizados e auditáveis.',
    escopo: 'Dados e BI',
  },
];
---

<section id="servicos" class="orbitas">
  <header class="orbitas-head">
    <p class="mono">Produtos</p>
    <h2>Quatro frentes de entrega</h2>
    <p class="orbitas-lead">
      Cada frente resolve uma parte do caminho: a interface que o cliente usa, o
      sistema que sustenta a operação e o dado que orienta a decisão.
    </p>
  </header>

  <div class="tiers">
    {
      produtos.map((p) => (
        <article class="tier">
          <p class="mono">{p.eyebrow}</p>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
          <button type="button" class="tier-cta" data-form data-escopo={p.escopo}>
            Solicitar proposta
          </button>
        </article>
      ))
    }

    <article class="tier tier-plus">
      <div class="tier-plus-copy">
        <p class="mono">04 · Sob demanda</p>
        <h3>TI em geral</h3>
        <p>
          Automações, APIs, integração entre sistemas e sustentação. Quando a
          operação depende de tecnologia, ela precisa continuar de pé.
        </p>
      </div>
      <button type="button" class="tier-cta" data-form data-escopo="TI em geral">
        Solicitar proposta
      </button>
    </article>
  </div>
</section>
