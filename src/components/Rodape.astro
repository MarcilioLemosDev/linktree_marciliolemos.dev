---
import { contatos } from '../dados/contato';
import type { Textos } from '../dados/textos';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const ano = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-id">
    <p class="nome mono">marciliolemos<span class="marca-tld">.dev</span></p>
    <p class="mono">{t.rodape.linha}</p>
    <p class="mono">© {ano}</p>
  </div>

  <nav class="footer-contatos" aria-label="WhatsApp, LinkedIn, Instagram">
    {
      contatos.map((c) => (
        <a class="mono" href={c.url} target="_blank" rel="noopener">
          {c.label} ↗
        </a>
      ))
    }
  </nav>
</footer>

<style>
  .footer-id .nome {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .marca-tld {
    color: var(--gold);
  }

  .footer-contatos {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .footer-contatos a {
    color: var(--dim);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: color 0.2s;
    min-height: 24px;
  }

  .footer-contatos a:hover {
    color: var(--gold);
  }
</style>
