---
// Herói: promessa na tarefa do leitor e um único CTA, direto no WhatsApp.
import { linkWhatsapp } from '../dados/contato';
import type { Textos } from '../dados/textos';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const cta = linkWhatsapp(t.wa.projeto);
---

<section id="topo" class="hero">
  <div class="hero-vinheta" aria-hidden="true"></div>
  <div class="hero-copy">
    <p class="mono eyebrow">{t.heroi.eyebrow}</p>
    <h1>{t.heroi.h1Antes}<em>{t.heroi.h1Destaque}</em>{t.heroi.h1Depois}</h1>
    <p class="hero-tag">{t.heroi.tag}</p>
    <a class="hero-cta" href={cta} target="_blank" rel="noopener">{t.heroi.cta}</a>
    <p class="hero-caption">{t.heroi.legenda}</p>
  </div>
</section>
