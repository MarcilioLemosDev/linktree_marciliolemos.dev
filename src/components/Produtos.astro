---
// Serviços/produtos de TI oferecidos. Reaproveita o design system dos tiers
// (.tiers/.tier/.tier-plus do global.css). Cada card abre o diálogo de contato
// já com o escopo escolhido (data-preset), que vai junto na mensagem.
const escopos = [
  {
    eyebrow: '01 · Web',
    titulo: 'Sites e landing pages',
    texto:
      'Site institucional, landing de conversão ou vitrine de produtos. Performance, SEO e layout responsivo — pronto para ser achado no Google e converter no celular.',
    cta: 'Quero um site',
    preset: 'Site',
  },
  {
    eyebrow: '02 · Apps',
    titulo: 'Aplicativos',
    texto:
      'Web, mobile e desktop. Do MVP enxuto para validar a ideia ao aplicativo publicado, com login, integrações e painel de administração.',
    cta: 'Quero um app',
    preset: 'Aplicativo',
  },
  {
    eyebrow: '03 · Dados',
    titulo: 'Dados e BI',
    texto:
      'Dashboards, integração de fontes, automação de relatórios e modelagem. Os seus números num só lugar, confiáveis e sempre atualizados.',
    cta: 'Quero ver meus dados',
    preset: 'Dados e BI',
  },
];
---

<section id="servicos" class="orbitas">
  <header class="orbitas-head">
    <p class="mono">Serviços</p>
    <h2>O que eu construo</h2>
    <p class="orbitas-lead">
      Produtos de TI de ponta a ponta: da interface que o seu cliente usa ao
      dado que orienta a sua decisão.
    </p>
  </header>

  <div class="tiers">
    {
      escopos.map((e) => (
        <article class="tier">
          <p class="mono">{e.eyebrow}</p>
          <h3>{e.titulo}</h3>
          <p>{e.texto}</p>
          <button type="button" class="tier-cta" data-aplicar="projeto" data-preset={e.preset}>
            {e.cta}
          </button>
        </article>
      ))
    }

    <article class="tier tier-plus">
      <div class="tier-plus-copy">
        <p class="mono">04 · Sob demanda</p>
        <h3>TI em geral</h3>
        <p>
          Automações, APIs, integração entre sistemas, manutenção e sustentação.
          Se envolve tecnologia na sua operação, dá para resolver.
        </p>
      </div>
      <button type="button" class="tier-cta" data-aplicar="projeto" data-preset="TI em geral">
        Falar sobre TI
      </button>
    </article>
  </div>
</section>
