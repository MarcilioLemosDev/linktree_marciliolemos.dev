---
import type { Textos } from '../dados/textos';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
---

<section id="prova" class="prova">
  <p class="mono prova-eyebrow">{t.prova.eyebrow}</p>
  <a
    class="prova-cliente"
    href="https://mi6consorcio.com.br"
    target="_blank"
    rel="noopener"
    aria-label={t.prova.dica}
  >
    <img
      src="/logo-mi6.png"
      alt="MI6 Consórcio Nacional"
      width="219"
      height="47"
      loading="lazy"
      decoding="async"
    />
    <span class="mono">mi6consorcio.com.br ↗</span>
  </a>
  <p class="prova-frase">{t.prova.frase}</p>
</section>
