---
// Prova social imediata (logo após o herói) — último projeto em produção,
// com link verificável.
---

<section id="prova" class="prova">
  <p class="mono prova-eyebrow">Projeto mais recente em produção</p>
  <a
    class="prova-cliente"
    href="https://mi6consorcio.com.br"
    target="_blank"
    rel="noopener"
  >
    <img
      src="/logo-mi6.png"
      alt="MI6 Consórcio Nacional"
      width="219"
      height="47"
      loading="lazy"
      decoding="async"
    />
    <span class="mono">mi6consorcio.com.br ↗</span>
    <span class="mono prova-hint">Clique na logo</span>
  </a>
  <p class="prova-frase">
    Site institucional, simulador de consórcio e funil de qualificação —
    no ar, com dados alimentando a operação.
  </p>
</section>
