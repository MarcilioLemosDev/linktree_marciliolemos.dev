---
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

import Hud from '../components/Hud.astro';
import Heroi from '../components/Heroi.astro';
import ProvaSocial from '../components/ProvaSocial.astro';
import Produtos from '../components/Produtos.astro';
import Rodape from '../components/Rodape.astro';
import Formulario from '../components/Formulario.astro';

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL('/', site).href;
const ogImg = new URL('/og.png', site).href;
const titulo = 'marciliolemos.dev · Sites, aplicativos e soluções de dados e BI';
const descricao =
  'Desenvolvimento de software sob medida: sites, aplicativos web, mobile e desktop, plataformas de dados e BI, e produtos de TI — do primeiro protótipo à operação em produção.';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, minimum-scale=1, viewport-fit=cover"
    />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#010206" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="marciliolemos.dev" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={ogImg} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={ogImg} />
  </head>
  <body>
    <canvas class="starfield" aria-hidden="true"></canvas>
    <Hud />
    <div class="grain" aria-hidden="true"></div>
    <main>
      <Heroi />
      <ProvaSocial />
      <Produtos />
    </main>
    <Rodape />
    <Formulario />
    <Analytics />

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';
      import { initEstrelas } from '../scripts/estrelas';

      gsap.registerPlugin(ScrollTrigger);
      // Barra de endereço do celular colapsa/expande sem re-medir os gatilhos.
      ScrollTrigger.config({ ignoreMobileResize: true });

      const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
      const mobile = window.matchMedia('(max-width: 760px)').matches;

      /* ── Campo de estrelas ───────────────────────────────────────────── */
      const ceu = document.querySelector<HTMLCanvasElement>('.starfield');
      if (ceu) initEstrelas(ceu);

      /* ── Scroll suave ────────────────────────────────────────────────── */
      // No mobile o scroll nativo é mais previsível (barra de endereço, inércia
      // do sistema, gesto de voltar); o Lenis fica só no desktop.
      let lenis: Lenis | null = null;
      if (motionOk && !mobile) {
        lenis = new Lenis({ lerp: 0.115 });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis!.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
      }

      /* ── Entradas por scroll (sem pin: o herói não prende a rolagem) ─── */
      if (motionOk) {
        gsap.from('.hero-copy > *', {
          y: 22,
          opacity: 0,
          duration: 0.7,
          stagger: 0.08,
          ease: 'power2.out',
        });

        gsap
          .timeline({
            scrollTrigger: { trigger: '#prova', start: 'top 88%', end: 'top 55%', scrub: 1 },
          })
          .fromTo(
            '.prova > *',
            { y: 24, opacity: 0 },
            { y: 0, opacity: 1, stagger: 0.12, ease: 'power2.out' }
          );

        gsap
          .timeline({
            scrollTrigger: { trigger: '#servicos', start: 'top 85%', end: 'top 45%', scrub: 1 },
          })
          .fromTo(
            '.orbitas-head > *',
            { y: 22, opacity: 0 },
            { y: 0, opacity: 1, stagger: 0.1, ease: 'power2.out' }
          )
          .fromTo(
            '.tier',
            { y: 28, opacity: 0 },
            { y: 0, opacity: 1, stagger: 0.09, ease: 'power2.out' },
            0.1
          );

        window.addEventListener('load', () => ScrollTrigger.refresh());
      }

      /* ── HUD: progresso e navegação ──────────────────────────────────── */
      const progressEl = document.querySelector<HTMLElement>('[data-hud-progress]');
      const topBar = document.querySelector<HTMLElement>('.hud-top');
      function onScroll() {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const p = max > 0 ? doc.scrollTop / max : 0;
        if (progressEl) progressEl.style.transform = `scaleX(${p})`;
        topBar?.classList.toggle('rolou', doc.scrollTop > 60);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      document.querySelectorAll<HTMLButtonElement>('[data-stop]').forEach((b) => {
        const id = b.dataset.stop!;
        b.addEventListener('click', () => {
          if (id === 'topo') {
            if (lenis) lenis.scrollTo(0, { duration: 1.2 });
            else window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }
          const alvo = document.getElementById(id);
          if (!alvo) return;
          if (lenis) lenis.scrollTo(alvo, { duration: 1.4 });
          else alvo.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      /* ── Seletor de idioma ───────────────────────────────────────────── */
      const langWrap = document.querySelector<HTMLElement>('[data-lang-switch]');
      const langBtn = document.querySelector<HTMLButtonElement>('[data-lang-btn]');
      const langMenu = document.querySelector<HTMLElement>('[data-lang-menu]');
      langBtn?.addEventListener('click', () => {
        const abrindo = langMenu?.hasAttribute('hidden');
        langMenu?.toggleAttribute('hidden', !abrindo);
        langBtn.setAttribute('aria-expanded', String(!!abrindo));
      });
      document.addEventListener('click', (e) => {
        if (langWrap && !langWrap.contains(e.target as Node)) {
          langMenu?.setAttribute('hidden', '');
          langBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>
